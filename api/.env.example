SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
ADMIN_PASSWORD=
# Backend RAG (Python FastAPI) — dùng cho proxy
RAG_BACKEND_URL=http://localhost:8000

# LLM config — unified cho chat streaming + OCR
# Key bắt đầu bằng 'AIza' → Gemini API; khác → OpenAI-compatible (OpenRouter/...)
LLM_API_KEY=
LLM_API_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4-flash

# (Các biến cũ giữ lại cho admin routes nếu cần)
CHAT_MODEL=openrouter/free
EMBED_MODEL=openrouter/free
