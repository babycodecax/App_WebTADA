# Supabase — tạo free project tại https://supabase.com, chạy schema.sql, điền vào đây
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-SERVICE-ROLE-KEY

# OpenRouter — lấy key tại https://openrouter.ai/keys
OPENROUTER_KEY=sk-or-...

# Model free mặc định (đổi dễ qua env)
MODEL_NAME=qwen/qwen-2.5-7b-instruct:free

# GitHub webhook (dùng ở Phase 5)
GITHUB_TOKEN=ghp_...
WEBHOOK_SECRET=your-webhook-secret

# Vault local — trỏ vào thư mục vault trong dự án
VAULT_DIR=D:/CodeApp/Projects/App_WebTADA/vault/thue-ke-toan
